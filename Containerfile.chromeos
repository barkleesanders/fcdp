FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      fontconfig \
      fonts-liberation \
      libasound2t64 \
      libcups2t64 \
      libdbus-1-3 \
      libexpat1 \
      libgbm1 \
      libgl1-mesa-dri \
      libnspr4 \
      libnss3 \
      libx11-6 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      mesa-vulkan-drivers \
      socat \
      xauth \
      xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 chromeos-entrypoint.sh /usr/local/bin/fcdp-chromeos-entrypoint

ENTRYPOINT ["/usr/local/bin/fcdp-chromeos-entrypoint"]
