#!/usr/bin/env python3
"""fcdp - most of the Chrome DevTools Protocol from the CLI, via our OWN MV3 extension.

ONE tool for everything on your REAL Default profile: everyday driving
(open/nav/read/find/click/type/fill/key/scroll/shot/wait/js/text) AND the four
advanced domains ccb cannot do (pdf/intercept/throttle/trace) — all through
chrome.debugger.sendCommand, which accepts ANY CDP method.

tabId is OPTIONAL on every command: `fcdp open <url>` caches the new tab in
~/.cache/fcdp-tab; omit tabId to use it, or pass it explicitly as the first arg.

Wire to the bridge (/tmp/fcdp.sock): 4-byte LE length prefix + JSON.
  request : {id, tabId, method, params}   or  {op:"subscribe", filter, tabId}
  reply   : {id, result|error}            events pushed as {event, tabId, params}
"""
import socket, struct, json, sys, os, base64, time, select, re, hashlib

SOCK = "/tmp/fcdp.sock"
# The active-tab cache is a SINGLE shared file by default, which is last-writer-wins.
# Two concurrent jobs therefore silently drive each other's tab: job A opens (cache=A),
# job B opens (cache=B), and job A's next tabId-less command targets B. Verified on
# mac-mini 2026-07-29 by watching the file change under two sequential opens.
# FCDP_TAB_CACHE gives a job its own cache file so tabId-less commands stay scoped to
# it — this is what `fcdp-job` sets, and what any concurrent cron should set.
CACHE_OVERRIDE = os.environ.get("FCDP_TAB_CACHE")

# ---- direct-CDP transport (no extension, no bridge) ---------------------------
# fcdp normally reaches Chrome through our MV3 extension + bridge, because Chrome
# 136+ REFUSES --remote-debugging-port on the real Default profile. That refusal is
# the entire reason this tool exists.
#
# It does NOT apply to a Chrome launched on its own --user-data-dir, which may expose
# a debug port freely. mac-mini runs exactly that (headless Chrome on :9222 with a
# logged-in profile, supervised by a KeepAlive launchd job). There, the
# extension route is impossible anyway: verified 2026-07-29 that --load-extension is
# INERT on Chrome 150 (scratch profile registered 0 extensions, no service-worker
# target), and a headless Chrome has no UI for the manual "Load unpacked" step.
#
# So: set FCDP_CDP_URL to a debug endpoint and the same CLI drives it over raw CDP.
#   FCDP_CDP_URL=http://127.0.0.1:9222 fcdp tabs
# Everything except the 5 bridge-only Meta.* calls is passed through untouched.
CDP_URL = os.environ.get("FCDP_CDP_URL", "").rstrip("/")
PIPE_SOCKET = os.path.expanduser(os.environ.get("FCDP_PIPE_SOCKET", ""))


def _autodetect_cdp():
    """Only consulted when there is NO bridge socket, so a host with a working bridge
    (the laptop) can never be silently switched off it. On a host like mac-mini — where
    the extension route is impossible (--load-extension inert on Chrome 150, and headless
    has no UI for Load-unpacked) but a debug-port Chrome is supervised — this makes plain
    `fcdp <cmd>` work with no env var.

    IPv6 first-class: a debug port often binds [::1] ONLY, which is exactly what made the
    2026-07-29 probe look dead when checked on 127.0.0.1."""
    import urllib.request
    for base in ("http://127.0.0.1:9222", "http://[::1]:9222"):
        try:
            with urllib.request.urlopen(base + "/json/version", timeout=2):
                return base
        except Exception:
            continue
    return None


# Resolve the transport EAGERLY. It must be known before argument parsing, because
# tabId syntax differs per transport (bridge = chrome.tabs ints, direct = hex target
# ids) and resolve_tid() runs long before the first Conn() is built.
if not CDP_URL and not PIPE_SOCKET and not os.path.exists(SOCK):
    _found = _autodetect_cdp()
    if _found:
        CDP_URL = _found
        print("fcdp: no bridge socket; using direct CDP at %s (set FCDP_CDP_URL to pin it)"
              % _found, file=sys.stderr)

# A bridge tab id is a chrome.tabs integer; a direct target id is an unrelated hex
# string. Reusing one cache file made switching transports silently aim a command at
# the wrong browser. Keep the historical bridge cache path, but namespace direct
# caches by endpoint. FCDP_TAB_CACHE remains the explicit per-job override.
if CACHE_OVERRIDE:
    CACHE = os.path.expanduser(CACHE_OVERRIDE)
elif CDP_URL or PIPE_SOCKET:
    endpoint = CDP_URL or ("pipe:" + PIPE_SOCKET)
    endpoint_key = hashlib.sha256(endpoint.encode("utf-8")).hexdigest()[:12]
    CACHE = os.path.expanduser("~/.cache/fcdp-tab-direct-%s" % endpoint_key)
else:
    CACHE = os.path.expanduser("~/.cache/fcdp-tab")

BROWSER_TARGET = "browser"


class DirectConn:
    """Raw-CDP transport, interface-compatible with Conn.

    Used when FCDP_CDP_URL points at a Chrome with --remote-debugging-port. Talks
    HTTP for target discovery and one WebSocket per tab for commands, so no
    extension and no bridge are involved.

    Meta.* are bridge concepts, emulated here:
      listTabs  -> GET /json/list           createTab -> PUT /json/new?url=
      closeTab  -> GET /json/close/<id>     attach/detach -> no-ops (raw CDP has
                   no debugger-arbitration; the port IS the attachment)
    """
    def __init__(self, timeout=120):
        import urllib.request
        self._url = urllib.request
        self.base = CDP_URL
        self.timeout = timeout
        self.evq = []
        self._ws = {}
        self._id = 0
        try:
            self._http("/json/version")
        except Exception as e:
            die("FCDP_CDP_URL=%s is not answering (%s).\n"
                "Is that Chrome running? Note IPv6: a debug port may bind [::1] only, "
                "so try http://[::1]:<port>." % (self.base, e))

    def _http(self, path):
        with self._url.urlopen(self.base + path, timeout=15) as r:
            return json.loads(r.read().decode("utf-8", "replace"))

    def _http_text(self, path):
        # /json/close/<id> and /json/activate/<id> answer with a bare string
        # ("Target is closing"), NOT JSON — json.loads() raises JSONDecodeError on
        # them. Every close through this transport crashed with a traceback until
        # this existed (found 2026-07-29 while pruning leaked tabs on mac-mini).
        # Worse, the crash was MISLEADING: the HTTP close had already succeeded, so
        # callers logged "FAILED" for tabs that were in fact closed.
        # 404 = no such target, i.e. already closed. Closing is idempotent by
        # nature and a pruner must be safe to re-run, so report it rather than raise.
        try:
            with self._url.urlopen(self.base + path, timeout=15) as r:
                return r.read().decode("utf-8", "replace").strip()
        except self._url.HTTPError as e:
            if e.code == 404:
                return "no such target (already closed)"
            raise

    def _pages(self):
        return [t for t in self._http("/json/list") if t.get("type") == "page"]

    def _sock(self, tabId):
        key = str(tabId)
        if key in self._ws:
            return self._ws[key]
        from websockets.sync.client import connect
        if key == BROWSER_TARGET:
            ws_url = self._http("/json/version").get("webSocketDebuggerUrl")
            if not ws_url:
                die("CDP endpoint %s does not advertise a browser WebSocket" % self.base)
        else:
            tgt = next((t for t in self._pages() if str(t.get("id")) == key), None)
            if tgt is None:
                die("no CDP target %s at %s (run `fcdp tabs` to list)" % (tabId, self.base))
            ws_url = tgt["webSocketDebuggerUrl"]
        ws = connect(ws_url, open_timeout=20,
                     close_timeout=5, max_size=64 * 1024 * 1024)
        self._ws[key] = ws
        return ws

    def _next(self):
        self._id += 1
        return self._id

    def cmd(self, tabId, method, params=None):
        params = params or {}
        if method == "Meta.listTabs":
            return {"result": {"tabs": [{"tabId": t.get("id"), "url": t.get("url"),
                                         "title": t.get("title")} for t in self._pages()]}}
        if method == "Meta.createTab":
            u = params.get("url") or "about:blank"
            import urllib.parse, urllib.request as _u
            req = _u.Request(self.base + "/json/new?" + urllib.parse.quote(u, safe=":/?&=#"),
                             method="PUT")
            with _u.urlopen(req, timeout=20) as r:
                t = json.loads(r.read().decode("utf-8", "replace"))
            return {"result": {"tabId": t.get("id")}}
        if method == "Meta.closeTab":
            self._ws.pop(str(tabId), None)  # drop the cached socket; target is going away
            return {"result": {"closed": True,
                               "note": self._http_text("/json/close/%s" % tabId)}}
        if method in ("Meta.attach", "Meta.detach"):
            # No arbitration in raw CDP — report success so callers behave identically.
            return {"result": {"ok": True, "note": "no-op in direct-CDP mode"}}

        if tabId is None:
            pages = self._pages()
            if not pages:
                die("no page targets at %s" % self.base)
            tabId = pages[0].get("id")
        ws = self._sock(tabId)
        cid = self._next()
        ws.send(json.dumps({"id": cid, "method": method, "params": params}))
        deadline = time.time() + self.timeout
        while time.time() < deadline:
            msg = json.loads(ws.recv(timeout=max(1, deadline - time.time())))
            if msg.get("id") == cid:
                return msg
            if msg.get("method"):                      # CDP event
                self.evq.append({"event": msg["method"], "tabId": tabId,
                                 "params": msg.get("params", {})})
        return {"error": {"message": "timeout waiting for %s" % method}}

    def send_only(self, tabId, method, params=None):
        self.cmd(tabId, method, params)

    def subscribe(self, filter=None, tabId=None):
        if tabId is None:
            pages = self._pages()
            tabId = pages[0].get("id") if pages else None
        self._sub_tab = tabId
        self._sock(tabId)
        return {"result": {"subscribed": True}}

    def collect(self, seconds, on_event=None):
        """Drain buffered events, then read the socket for `seconds`. Mirrors
        _BridgeConn.collect so event-driven commands behave the same either way."""
        events = []
        for f in self.evq:
            events.append(f)
            if on_event:
                on_event(f)
        self.evq = []
        tabId = getattr(self, "_sub_tab", None) or next(iter(self._ws), None)
        if tabId is None:
            return events
        ws = self._sock(tabId)
        end = time.time() + seconds
        while True:
            remaining = end - time.time()
            if remaining <= 0:
                break
            try:
                msg = json.loads(ws.recv(timeout=remaining))
            except Exception:
                break                                  # timeout or closed: done collecting
            if msg.get("method"):
                ev = {"event": msg["method"], "tabId": tabId, "params": msg.get("params", {})}
                events.append(ev)
                if on_event:
                    on_event(ev)
        return events

    def close(self):
        for ws in self._ws.values():
            try:
                ws.close()
            except Exception:
                pass
        self._ws.clear()


class _BridgeConn:
    """One persistent Unix-socket connection to the bridge. Demuxes command
    replies (have `id`) from CDP events (have `event`)."""
    def __init__(self, timeout=120, sock_path=SOCK):
        self.sock_path = sock_path
        if not os.path.exists(sock_path):
            die("bridge socket %s not found — is its bridge running?" % sock_path)
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.settimeout(timeout)
        try:
            self.s.connect(sock_path)
        except Exception as e:
            die("could not connect to bridge at %s (%s)" % (sock_path, e))
        self.buf = b""
        self.evq = []
        self._id = 0

    def _next(self):
        self._id += 1
        return self._id

    def _send(self, obj):
        body = json.dumps(obj).encode()
        self.s.sendall(struct.pack("<I", len(body)) + body)

    def _read_one(self):
        while True:
            if len(self.buf) >= 4:
                n = struct.unpack("<I", self.buf[:4])[0]
                if len(self.buf) >= 4 + n:
                    frame = self.buf[4:4 + n]
                    self.buf = self.buf[4 + n:]
                    return json.loads(frame.decode("utf-8", "replace"))
            d = self.s.recv(65536)
            if not d:
                return None
            self.buf += d

    def cmd(self, tabId, method, params=None):
        cid = self._next()
        self._send({"id": cid, "tabId": tabId, "method": method, "params": params or {}})
        while True:
            f = self._read_one()
            if f is None:
                return {"error": {"message": "connection closed"}}
            if f.get("id") == cid:
                return f
            if f.get("event"):
                self.evq.append(f)

    def send_only(self, tabId, method, params=None):
        cid = self._next()
        self._send({"id": cid, "tabId": tabId, "method": method, "params": params or {}})

    def subscribe(self, filter=None, tabId=None):
        self._send({"op": "subscribe", "filter": filter or [], "tabId": tabId})
        return self._read_one()

    def collect(self, seconds, on_event=None):
        events = []
        for f in self.evq:
            events.append(f)
            if on_event:
                on_event(f)
        self.evq = []
        end = time.time() + seconds
        while True:
            remaining = end - time.time()
            if remaining <= 0:
                break
            r, _, _ = select.select([self.s], [], [], remaining)
            if not r:
                break
            d = self.s.recv(65536)
            if not d:
                break
            self.buf += d
            while len(self.buf) >= 4:
                n = struct.unpack("<I", self.buf[:4])[0]
                if len(self.buf) < 4 + n:
                    break
                obj = json.loads(self.buf[4:4 + n].decode("utf-8", "replace"))
                self.buf = self.buf[4 + n:]
                if obj.get("event"):
                    events.append(obj)
                    if on_event:
                        on_event(obj)
        return events

    def close(self):
        try:
            self.s.close()
        except Exception:
            pass


def Conn(timeout=120):
    """Select pipe, remote-debugging port, or real-profile extension transport."""
    if PIPE_SOCKET:
        return _BridgeConn(timeout, PIPE_SOCKET)
    if CDP_URL:
        return DirectConn(timeout)
    return _BridgeConn(timeout)


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def show(r):
    # The 8000-char cap keeps interactive output readable, but it SILENTLY emits invalid
    # JSON — a programmatic consumer piping `fcdp raw ... | json.loads` just gets
    # "Unexpected end of JSON input" with nothing pointing at the cap. (Cost a debugging
    # cycle 2026-07-29 porting caltrans-pra capture-session.mjs off the removed :9222.)
    # Default behavior is unchanged; FCDP_FULL=1 opts into complete output, and any
    # truncation now announces itself on STDERR so it can't corrupt piped JSON.
    out = json.dumps(r, indent=2)
    if os.environ.get("FCDP_FULL") == "1" or len(out) <= 8000:
        print(out)
        return
    print(out[:8000])
    print(
        "fcdp: output truncated at 8000 chars (%d total) — this JSON is INCOMPLETE. "
        "Set FCDP_FULL=1 for the full payload." % len(out),
        file=sys.stderr,
    )


def result_or_die(r, what):
    if isinstance(r, dict) and r.get("error"):
        die("%s failed: %s" % (what, r["error"].get("message")))
    return r.get("result", {}) if isinstance(r, dict) else r


# ---- tab cache so tabId is optional on every command --------------------------
def save_tab(tid):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        open(CACHE, "w").write(str(tid))
    except Exception:
        pass


def cached_tab():
    try:
        v = open(CACHE).read().strip()
    except Exception:
        return None
    if not v:
        return None
    return int(v) if v.isdigit() else v          # direct-CDP ids are hex strings


def _is_tid(s):
    """Bridge tab ids are chrome.tabs integers; direct-CDP target ids are 32-char
    uppercase hex. Accept hex ONLY in direct mode so a hex-looking argument can't be
    mistaken for a tabId when talking to the bridge."""
    if re.fullmatch(r"\d+", s):
        return True
    return bool(CDP_URL or PIPE_SOCKET) and (
        s == BROWSER_TARGET or bool(re.fullmatch(r"[0-9A-Fa-f]{16,}", s))
    )


def resolve_tid(a, idx):
    """Return (tabId, remaining_args). Uses a[idx] if it looks like a tab id for the
    active transport, else the cached tab."""
    if len(a) > idx and _is_tid(a[idx]):
        v = a[idx]
        return (int(v) if v.isdigit() else v), a[idx + 1:]
    t = cached_tab()
    if t is None and CDP_URL:
        # Direct mode has no `fcdp open` history to seed the cache, and a freshly
        # provisioned host (mac-mini) therefore failed EVERY command with
        # "no tabId given and none cached" — breaking this tool's stated contract that
        # "tabId is OPTIONAL on every command". The debug port already enumerates its
        # targets, so fall back to the first page rather than dying.
        try:
            import urllib.request
            with urllib.request.urlopen(CDP_URL + "/json/list", timeout=5) as r:
                pages = [x for x in json.loads(r.read().decode("utf-8", "replace"))
                         if x.get("type") == "page"]
            if pages:
                t = pages[0].get("id")
        except Exception:
            pass
    if t is None and PIPE_SOCKET:
        try:
            conn = _BridgeConn(5, PIPE_SOCKET)
            reply = conn.cmd(None, "Meta.listTabs")
            conn.close()
            tabs = reply.get("result", {}).get("tabs", [])
            if tabs:
                t = tabs[0].get("tabId")
        except Exception:
            pass
    if t is None:
        die("no tabId given and none cached — run `fcdp open <url>` first, or pass a tabId"
            + ("\n(direct-CDP mode: `fcdp tabs` lists hex target ids)" if CDP_URL else ""))
    return t, a[idx:]


def evalv(conn, tid, expr):
    # replMode:True lets a snippet re-declare `const`/`let` on a repeat call instead of
    # throwing "Identifier 'x' has already been declared". The page's default execution
    # context persists across evaluate calls (REPL semantics); replMode is how DevTools'
    # own console tolerates it. (Verified against Claude-for-Chrome's CDP driver, 2026-07-12.)
    r = conn.cmd(tid, "Runtime.evaluate",
                 {"expression": expr, "returnByValue": True, "awaitPromise": True, "replMode": True})
    res = result_or_die(r, "Runtime.evaluate")
    return res.get("result", {}).get("value")


def click_at(conn, tid, x, y):
    for typ in ("mousePressed", "mouseReleased"):
        conn.cmd(tid, "Input.dispatchMouseEvent",
                 {"type": typ, "x": int(x), "y": int(y), "button": "left", "clickCount": 1})


KEYS = {
    "Enter": ("Enter", "Enter", 13, "\r"), "Return": ("Enter", "Enter", 13, "\r"),
    "Tab": ("Tab", "Tab", 9, None), "Escape": ("Escape", "Escape", 27, None), "Esc": ("Escape", "Escape", 27, None),
    "Backspace": ("Backspace", "Backspace", 8, None), "Delete": ("Delete", "Delete", 46, None),
    "ArrowUp": ("ArrowUp", "ArrowUp", 38, None), "ArrowDown": ("ArrowDown", "ArrowDown", 40, None),
    "ArrowLeft": ("ArrowLeft", "ArrowLeft", 37, None), "ArrowRight": ("ArrowRight", "ArrowRight", 39, None),
    "Space": (" ", "Space", 32, " "),
}


def press_key(conn, tid, name):
    k = KEYS.get(name) or KEYS.get(name.capitalize())
    if not k:
        die("unknown key: %s (known: %s)" % (name, ", ".join(sorted(KEYS))))
    key, code, vk, text = k
    down = {"type": "keyDown", "key": key, "code": code, "windowsVirtualKeyCode": vk, "nativeVirtualKeyCode": vk}
    if text:
        down["text"] = text
    conn.cmd(tid, "Input.dispatchKeyEvent", down)
    conn.cmd(tid, "Input.dispatchKeyEvent",
             {"type": "keyUp", "key": key, "code": code, "windowsVirtualKeyCode": vk, "nativeVirtualKeyCode": vk})


